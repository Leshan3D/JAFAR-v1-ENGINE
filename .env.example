# ── Telegram ────────────────────────────────────────────────
# Create with @BotFather → /newbot → paste the token.
TELEGRAM_BOT_TOKEN=
# Optional: your numeric chat id (message @userinfobot to find it).
# Leave empty — the service adopts whoever sends /start first.
TELEGRAM_CHAT_ID=

# ── FRED (macro series) ──────────────────────────────────────
# Free key: https://fredaccount.stlouisfed.org/apikeys
# Leave empty to skip FRED series gracefully (everything else still runs).
FRED_API_KEY=

# ── Cadence, seconds (rate-limit budget in DEPLOY.md) ───────
# Full pipeline: news + FinBERT + FRED + Polymarket + Fear&Greed
PIPELINE_INTERVAL_S=3600
# Light price-only refresh (Binance + yfinance) + signals recompute
PRICE_REFRESH_INTERVAL_S=900
# Entry-zone price poll (Binance ticker / yfinance quote)
ZONE_POLL_INTERVAL_S=60

# ── Macro calendar + alarms ─────────────────────────────────
# Pre-print warnings and an immediate post-print pipeline wake, driven by
# macro_calendar.py (FRED release dates + bundled FOMC schedule).
MACRO_ALERTS_ENABLED=1
MACRO_POLL_INTERVAL_S=60
# Warn this many minutes before a release (comma separated).
MACRO_LEAD_MIN=120,30,10
# Wait this long after the print before re-running (lets the number + first
# headlines land), and how long after it we still consider firing.
MACRO_POST_DELAY_S=45
MACRO_POST_EVENT_GRACE_S=600
# How far ahead to build the calendar, and how often to refresh it.
MACRO_CALENDAR_HORIZON_DAYS=180
MACRO_REFRESH_S=43200
# Optional hand-maintained events, merged over the fetched ones. A JSON list:
# [{"short":"ECB","name":"ECB rate decision","date":"2026-12-17",
#   "time_et":"08:15","importance":"high","affects":"EUR, gold, USD"}]
# Saved as DATA_DIR/macro_calendar_manual.json

# ── Loud PC alarm (fires on the machine running this service) ──
# Uses notify-send (critical popup) + paplay (repeating tone). Both ship with
# Omarchy; harmless no-op if either is missing.
MACRO_PC_ALARM_ENABLED=1
# Loud reminders this many minutes before a release, plus one AT the print.
MACRO_PC_ALARM_LEAD_MIN=15,5
MACRO_PC_ALARM_SOUND=/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga
# Total seconds to keep repeating the tone, then stop (non-blocking).
MACRO_PC_ALARM_SECONDS=30
# Stream volume passed to paplay, 0-65536.
MACRO_PC_ALARM_VOLUME=65536
MACRO_PC_ALARM_ICON=dialog-warning

# ── Optional: LLM chat for free-text bot messages ──
# Any OpenAI-compatible endpoint. Defaults target LLM Zen, which serves
# FREE models. Get a key at https://llm.ai/auth (Zen), then:
#   Big Pickle (free):        OPENAI_MODEL=big-pickle            API_STYLE=chat
#   Muse Spark 1.3 (free):    OPENAI_MODEL=muse-spark-1.3-contributor-free
#                                                              API_STYLE=responses
# chat = POST {base}/chat/completions ; responses = POST {base}/responses
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.ai/zen/v1
OPENAI_MODEL=big-pickle
OPENAI_API_STYLE=chat

# ── Kronos forecast layer (foundation model, runs automatically) ──
# Auto-runs after build_snapshot (hourly) AND on the 15-min light refresh.
# Lives in its own venv because Kronos pins pandas 2.2.2 while the engine uses
# pandas 3.x.
KRONOS_ENABLED=1
KRONOS_ON_LIGHT=1
# Interpreter that has Kronos + its deps installed.
KRONOS_PYTHON=/home/jafar/.venvs/trading-kronos/bin/python
# Model size: Kronos-small (fast, default) | Kronos-mini (fastest) | Kronos-base (slowest)
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
# Default forecast horizon in bars. Overridden per asset for the daily-candle
# assets (gold/Brent/DXY -> 3 bars) in build_snapshot.KRONOS_PRED_LEN_BY_ASSET.
KRONOS_PRED_LEN=24
KRONOS_LOOKBACK=400
KRONOS_SEED=42
KRONOS_TIMEOUT_S=1800
# ── How Kronos feeds the signal engine (gate, not vote) ──
# It does NOT vote in the composite unless KRONOS_FACTOR_WEIGHT > 0. By default
# it is a filter: if it strongly OPPOSES the rules-based direction, the action
# is stepped toward HOLD and size is cut. Agreement/neutrality = no change.
KRONOS_FACTOR_WEIGHT=0
KRONOS_GATE=1
# |forecast score| above which Kronos is treated as having an opinion (0-100).
KRONOS_GATE_THRESH=50
# Position-size multiplier applied when Kronos opposes the trade.
KRONOS_SIZE_FLOOR=0.5
# Minimum |z| for the forecast to be allowed to veto a rules-based setup.
# The gate score is 100*tanh(z), so the old score threshold of 50 fired at
# |z| = 0.55 — less than one standard deviation, i.e. noise, from a model
# whose own hit rate is 52.9%. At 2.0 the forecast has to be a real move
# before it can step an action toward HOLD.
KRONOS_GATE_MIN_Z=2.0

# ── Crowd (Polymarket) scoring ──
# The crowd's surprise against the strike-implied probability, scaled to
# +/-100. 250 means a 40pp disagreement is a maximum-strength factor.
# CROWD_SURPRISE_SCALE=250
# When the spot implied by the crowd's own prices sits further than this from
# our price series (a Brent series against "WTI" contracts, say), the
# comparison is measuring the basis rather than the crowd's opinion: the read
# is damped by CROWD_BASIS_MISMATCH_DAMP and flagged in the snapshot.
# CROWD_BASIS_MISMATCH_TOL=0.08
# CROWD_BASIS_MISMATCH_DAMP=0.75

# ── Trader (human-in-the-loop execution) ──
# Engine PROPOSES; nothing is sent until you click APPROVE (dashboard or
# Telegram). Crypto only — gold/Brent/DXY/equities stay advisory.
# paper (default) = simulate fills, touch no exchange | off = disable planning
TRADING_MODE=paper
# Binance USDT-M Futures API keys. Testnet keys come from
# https://testnet.binancefuture.com (API key must be withdrawal-DISABLED).
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Override endpoint (blank = auto: testnet for testnet mode, fapi for live).
BINANCE_FUTURES_BASE=
# Which symbols the executor is allowed to trade.
TRADE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,ZECUSDT
# Equity used to size orders. Paper mode uses this; testnet/live read the real
# USDT futures balance.
TRADE_EQUITY_USDT=100
# Leverage applied on entry (keep at 1 until you trust the loop).
TRADE_LEVERAGE=1
# Hard caps / rails.
TRADE_MAX_NOTIONAL=100
TRADE_MAX_POSITIONS=3
TRADE_DAILY_LOSS_LIMIT=25
# Minutes a proposal stays approvable before it expires (levels go stale).
TRADE_APPROVAL_TTL_S=900
# Kill switch: if a file with this name exists in DATA_DIR, all execution halts.
KILL_SWITCH=KILL_SWITCH

# ── MEXC futures executor (mexc_exec.py) ──
# Separate from the Binance trader above. Human-approved: nothing fires until
# you run the order with --confirm EXECUTE. Create the key at
# https://www.mexc.com/user/openapi with FUTURES trading ON and WITHDRAW OFF,
# and IP-whitelist this machine. Never commit these.
MEXC_API_KEY=
MEXC_API_SECRET=
# 1 = preview only (default). Must be 0 AND --confirm EXECUTE to place.
MEXC_DRY_RUN=1
MEXC_LEVERAGE=10
# 1 = isolated margin, 2 = cross.
MEXC_OPEN_TYPE=1
# Hard caps / rails.
MEXC_MAX_NOTIONAL=30000
MEXC_MAX_POSITIONS=3
# Reject if live price has drifted this far from --entry (percent).
MEXC_MAX_DRIFT_PCT=0.5

# ── Evidence quality gate ──
# A composite score says what the engine thinks; these say how much it
# actually knows. Proposals are skipped (fail-closed) when the evidence
# behind them is thin, and sized down when it is merely usable.
# 1 = block proposals that fail the floors below, 0 = only warn.
TRADE_QUALITY_STRICT=1
# Minimum headlines behind a signal.
TRADE_MIN_HEADLINES=5
# Minimum average FinBERT confidence across those headlines.
TRADE_MIN_SENTIMENT_CONF=0.55
# Maximum age of the news layer in seconds (5400 = 90 min). The full
# pipeline runs hourly, so anything older means the news pull has failed.
TRADE_MAX_NEWS_AGE_S=5400
# Number of dead feeds that counts as feed degradation.
TRADE_FEED_DEGRADED_COUNT=3
# Crypto is not blocked by a partial news-feed outage (the RSS layer is
# duplicated across assets and crypto has four other evidence legs): dead
# feeds scale the order down to 60% instead of vetoing it. Set this to 1 to
# restore the veto for crypto as well.
TRADE_CRYPTO_FEED_BLOCK=0
# Going live requires BOTH TRADING_MODE=live and this exact confirmation.
TRADE_LIVE_CONFIRM=
